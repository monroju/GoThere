          "questions": [
            { "id": "employment_status", "type": "single_choice", "label": "Primary income source", "options": [
              { "id": "pension", "label": "Pension" },
              { "id": "investments", "label": "Investments/dividends" },
              { "id": "rental", "label": "Rental income" },
              { "id": "savings", "label": "Savings" }
            ], "required": true },
            { "id": "family_situation", "type": "single_choice", "label": "Who is relocating?", "options": [
              { "id": "single", "label": "Just me" },
              { "id": "couple", "label": "With partner/spouse" },
              { "id": "family", "label": "Family with children" }
            ], "required": true },
            { "id": "num_dependents", "type": "number", "label": "Number of children", "showIf": { "family_situation": "family" }, "min": 1, "max": 10 },
            { "id": "country_of_residence", "type": "single_choice", "label": "Current country of residence", "options": [
              { "id": "us", "label": "United States" },
              { "id": "uk", "label": "United Kingdom" },
              { "id": "canada", "label": "Canada" },
              { "id": "other", "label": "Other" }
            ], "required": true }
          ]
        },
        {
          "id": "financial",
          "title": "Financial Readiness",
          "subtitle": "Portugal requires proof of sufficient passive income.",
          "questions": [
            { "id": "monthly_income_range", "type": "single_choice", "label": "Monthly passive income (USD)", "options": [
              { "id": "under_1500", "label": "Under $1,500" },
              { "id": "1500_2500", "label": "$1,500 - $2,500" },
              { "id": "2500_4000", "label": "$2,500 - $4,000" },
              { "id": "over_4000", "label": "Over $4,000" }
            ], "required": true, "hint": "Portugal requires 100% of minimum wage (~$900/month) for applicant + 50% per dependent." },
            { "id": "has_health_insurance", "type": "boolean", "label": "Do you have international health insurance valid in Portugal?", "required": true },
            { "id": "has_background_check", "type": "boolean", "label": "Do you have a recent police background check?", "required": true },
            { "id": "has_nif", "type": "boolean", "label": "Do you already have a Portuguese NIF (tax number)?", "required": true }
          ]
        },
        {
          "id": "timeline",
          "title": "Your Timeline",
          "questions": [
            { "id": "target_move", "type": "single_choice", "label": "When do you plan to move?", "options": [
              { "id": "asap", "label": "As soon as possible" },
              { "id": "3_months", "label": "In ~3 months" },
              { "id": "6_months", "label": "In ~6 months" },
              { "id": "1_year", "label": "In ~1 year" }
            ], "required": true },
            { "id": "has_accommodation", "type": "boolean", "label": "Do you have accommodation arranged in Portugal?", "required": true }
          ]
        }
      ],
      "taskRules": [
        { "taskTitle": "Obtain Portuguese NIF (tax number)", "phase": "Phase 1: Research & Planning", "description": "Apply via Bordr.io (remote) or at a Financas office in Portugal. Required for almost everything.", "links": [{ "label": "Bordr NIF Service", "url": "https://bordr.io" }, { "label": "Portal das Financas", "url": "https://www.portaldasfinancas.gov.pt" }], "conditions": { "has_nif": false }, "estimatedWeeks": 22, "order": 1 },
        { "taskTitle": "Request FBI background check", "phase": "Phase 2: Documentation", "conditions": { "has_background_check": false, "country_of_residence": ["us"] }, "estimatedWeeks": 20, "order": 2 },
        { "taskTitle": "Get police background check", "phase": "Phase 2: Documentation", "conditions": { "has_background_check": false, "country_of_residence": ["uk", "canada", "other"] }, "estimatedWeeks": 18, "order": 2 },
