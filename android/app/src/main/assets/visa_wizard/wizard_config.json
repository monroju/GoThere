                { "id": "other_eu", "label": "Other EU country" },
                { "id": "other", "label": "Other" }
              ],
              "required": true
            }
          ]
        },
        {
          "id": "financial",
          "title": "Work & Income",
          "subtitle": "The DNV requires proof of remote employment and minimum income.",
          "questions": [
            {
              "id": "monthly_income_range",
              "type": "single_choice",
              "label": "Monthly gross income (USD)",
              "options": [
                { "id": "under_3000", "label": "Under $3,000" },
                { "id": "3000_5000", "label": "$3,000 - $5,000" },
                { "id": "5000_8000", "label": "$5,000 - $8,000" },
                { "id": "over_8000", "label": "Over $8,000" }
              ],
              "required": true,
              "hint": "Spain requires 200% of the minimum wage (~$3,200/month) for the DNV."
            },
            {
              "id": "has_health_insurance",
              "type": "boolean",
              "label": "Do you have international health insurance valid in Spain?",
              "required": true
            },
            {
              "id": "has_background_check",
              "type": "boolean",
              "label": "Do you have a recent police background check?",
              "required": true
            },
            {
              "id": "company_years",
              "type": "single_choice",
              "label": "How long have you worked for your current employer/clients?",
              "options": [
                { "id": "under_1", "label": "Less than 1 year" },
                { "id": "1_3", "label": "1-3 years" },
                { "id": "over_3", "label": "Over 3 years" }
              ],
              "required": true,
              "hint": "Spain requires at least 1 year of employment history with the company."
            }
          ]
        },
        {
          "id": "timeline",
          "title": "Your Timeline",
          "subtitle": "The DNV application process typically takes 2-4 months.",
          "questions": [
            {
              "id": "target_move",
              "type": "single_choice",
              "label": "When do you plan to move?",
              "options": [
                { "id": "asap", "label": "As soon as possible" },
                { "id": "3_months", "label": "In ~3 months" },
                { "id": "6_months", "label": "In ~6 months" },
                { "id": "1_year", "label": "In ~1 year" }
              ],
              "required": true
            },
            {
              "id": "has_accommodation",
              "type": "boolean",
              "label": "Do you have accommodation arranged?",
              "required": true
            },
            {
              "id": "has_consulate_appt",
              "type": "boolean",
              "label": "Have you booked a consulate appointment?",
              "required": true
            }
          ]
        }
      ],
      "taskRules": [
        { "taskTitle": "Confirm employer will provide remote work letter", "phase": "Phase 1: Research & Planning", "description": "Your employer must issue a letter confirming your remote work arrangement, role, salary, and that they have no presence in Spain.", "conditions": { "employment_type": "employed" }, "estimatedWeeks": 20, "order": 1 },
        { "taskTitle": "Prepare freelance contract portfolio", "phase": "Phase 1: Research & Planning", "description": "Gather contracts from your top clients showing ongoing remote work relationships (minimum 1 year history).", "conditions": { "employment_type": ["freelancer", "business_owner"] }, "estimatedWeeks": 20, "order": 1 },
        { "taskTitle": "Research your assigned Spanish consulate", "phase": "Phase 1: Research & Planning", "description": "Find the Spanish consulate that covers your jurisdiction.", "links": [{ "label": "Consulate Finder", "url": "https://www.exteriores.gob.es/en/EmbajadasConsulados/Paginas/index.aspx" }], "conditions": {}, "estimatedWeeks": 22, "order": 2 },
        { "taskTitle": "Request FBI Identity History Summary", "phase": "Phase 2: Documentation", "description": "Order from FBI website. Takes 12-18 weeks by mail.", "links": [{ "label": "FBI Identity History", "url": "https://www.fbi.gov/how-we-can-help-you/more-fbi-services-and-information/identity-history-summary-checks" }], "conditions": { "has_background_check": false, "country_of_residence": ["us"] }, "estimatedWeeks": 20, "order": 3 },
        { "taskTitle": "Get police background check", "phase": "Phase 2: Documentation", "conditions": { "has_background_check": false, "country_of_residence": ["uk", "canada", "other_eu", "other"] }, "estimatedWeeks": 18, "order": 3 },
        { "taskTitle": "Apostille background check", "phase": "Phase 2: Documentation", "description": "Send to your country's apostille authority (US: State Department, UK: FCO).", "conditions": {}, "estimatedWeeks": 16, "order": 4 },
        { "taskTitle": "Obtain international health insurance for Spain", "phase": "Phase 2: Documentation", "description": "Full coverage, no co-pays, valid in Spain.", "conditions": { "has_health_insurance": false }, "estimatedWeeks": 14, "order": 5 },
        { "taskTitle": "Gather 12 months of payslips/invoices", "phase": "Phase 2: Documentation", "description": "Proof of consistent remote income above the minimum threshold.", "conditions": {}, "estimatedWeeks": 14, "order": 6 },
        { "taskTitle": "Gather documents for spouse", "phase": "Phase 2: Documentation", "description": "Marriage certificate (apostilled), spouse's passport copy, additional income proof.", "conditions": { "family_situation": ["couple", "family"] }, "estimatedWeeks": 14, "order": 7 },
        { "taskTitle": "Gather documents for {num_dependents} child(ren)", "phase": "Phase 2: Documentation", "description": "Birth certificates (apostilled), passport copies.", "conditions": { "family_situation": "family" }, "estimatedWeeks": 14, "order": 8 },
        { "taskTitle": "Request university degree certificate (if applicable)", "phase": "Phase 2: Documentation", "description": "Spain may require proof of qualifications for the DNV. Get your degree apostilled.", "conditions": {}, "estimatedWeeks": 14, "order": 9 },
        { "taskTitle": "Book consulate appointment", "phase": "Phase 3: Application", "conditions": { "has_consulate_appt": false }, "estimatedWeeks": 12, "order": 10 },
        { "taskTitle": "Complete visa application form", "phase": "Phase 3: Application", "conditions": {}, "estimatedWeeks": 8, "order": 11 },
        { "taskTitle": "Secure accommodation in Spain", "phase": "Phase 3: Application", "description": "Rental contract or proof of housing.", "conditions": { "has_accommodation": false }, "estimatedWeeks": 10, "order": 12 },
        { "taskTitle": "Attend consulate appointment with all documents", "phase": "Phase 3: Application", "conditions": {}, "estimatedWeeks": 6, "order": 13 },
        { "taskTitle": "Research schools for children", "phase": "Phase 1: Research & Planning", "conditions": { "family_situation": "family" }, "estimatedWeeks": 20, "order": 14 },
        { "taskTitle": "Apply for NIE/TIE within 30 days of arrival", "phase": "Phase 4: Arrival & Setup", "description": "Apply for your Foreigner Identity Card at the Oficina de Extranjeria.", "conditions": {}, "estimatedWeeks": 0, "order": 15 },
        { "taskTitle": "Register at local town hall (Empadronamiento)", "phase": "Phase 4: Arrival & Setup", "conditions": {}, "estimatedWeeks": 0, "order": 16 },
        { "taskTitle": "Open a Spanish bank account", "phase": "Phase 4: Arrival & Setup", "conditions": {}, "estimatedWeeks": 0, "order": 17 },
        { "taskTitle": "Register as Autonomo (if freelancer)", "phase": "Phase 4: Arrival & Setup", "description": "Freelancers must register with Social Security and Hacienda as self-employed (Autonomo).", "conditions": { "employment_type": ["freelancer", "business_owner"] }, "estimatedWeeks": 0, "order": 18 },
        { "taskTitle": "Apply for Beckham Law tax regime", "phase": "Phase 5: Residency Follow-up", "description": "DNV holders may qualify for the special tax regime (flat 24% on Spanish-sourced income for 6 years).", "conditions": {}, "estimatedWeeks": 0, "order": 19 }
      ]
    },

    "pt_d7_passive_income": {
      "displayName": "Portugal - D7 Passive Income Visa",
      "countryId": "portugal",
      "shortName": "D7",
      "steps": [
        {
          "id": "personal",
          "title": "About You",
