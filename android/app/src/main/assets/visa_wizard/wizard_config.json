    "mx_temp_resident_economic_solvency": {
      "displayName": "Mexico - Temporary Resident (Economic Solvency)",
      "countryId": "mexico",
      "shortName": "Temp Res",
      "steps": [
        {
          "id": "personal",
          "title": "About You",
          "subtitle": "Mexico's Temporary Resident visa via economic solvency is the most common pathway.",
          "questions": [
            { "id": "employment_status", "type": "single_choice", "label": "Primary income source", "options": [
              { "id": "retired", "label": "Retired" },
              { "id": "employed_remote", "label": "Employed (Remote)" },
              { "id": "self_employed", "label": "Self-Employed" },
              { "id": "investor", "label": "Investments/savings" }
            ], "required": true },
            { "id": "family_situation", "type": "single_choice", "label": "Who is relocating?", "options": [
              { "id": "single", "label": "Just me" },
              { "id": "couple", "label": "With partner/spouse" },
              { "id": "family", "label": "Family with children" }
            ], "required": true },
            { "id": "num_dependents", "type": "number", "label": "Number of children", "showIf": { "family_situation": "family" }, "min": 1, "max": 10 }
          ]
        },
        {
          "id": "financial",
          "title": "Financial Readiness",
          "subtitle": "Mexico requires proof of economic solvency via bank statements.",
          "questions": [
            { "id": "proof_method", "type": "single_choice", "label": "How will you prove solvency?", "options": [
              { "id": "monthly_income", "label": "Monthly income (6 months of statements)" },
              { "id": "savings_balance", "label": "Savings balance (12 months of statements)" }
            ], "required": true, "hint": "Monthly income: ~$2,800/month average. Savings: ~$47,000 balance over 12 months." },
            { "id": "meets_threshold", "type": "boolean", "label": "Do your bank statements meet or exceed these thresholds?", "required": true }
          ]
        },
        {
          "id": "timeline",
          "title": "Your Timeline",
          "subtitle": "Mexico's consulate process is relatively fast: 1-3 weeks.",
          "questions": [
            { "id": "target_move", "type": "single_choice", "label": "When do you plan to move?", "options": [
              { "id": "asap", "label": "As soon as possible" },
              { "id": "3_months", "label": "In ~3 months" },
              { "id": "6_months", "label": "In ~6 months" },
              { "id": "1_year", "label": "In ~1 year" }
            ], "required": true },
            { "id": "has_accommodation", "type": "boolean", "label": "Do you have accommodation arranged in Mexico?", "required": true }
          ]
        }
      ],
      "taskRules": [
        { "taskTitle": "Find your assigned Mexican consulate", "phase": "Phase 1: Research & Planning", "description": "Each US state is assigned to a specific Mexican consulate.", "links": [{ "label": "Consulate Finder", "url": "https://consulmex.sre.gob.mx/" }], "conditions": {}, "estimatedWeeks": 16, "order": 1 },
        { "taskTitle": "Gather 6 months of bank statements", "phase": "Phase 2: Documentation", "description": "Must show average monthly income of ~$2,800 USD (or equivalent).", "conditions": { "proof_method": "monthly_income" }, "estimatedWeeks": 12, "order": 2 },
        { "taskTitle": "Gather 12 months of bank statements", "phase": "Phase 2: Documentation", "description": "Must show average balance of ~$47,000 USD (or equivalent).", "conditions": { "proof_method": "savings_balance" }, "estimatedWeeks": 12, "order": 2 },
        { "taskTitle": "Get passport photos (Mexico format)", "phase": "Phase 2: Documentation", "description": "White background, recent, specific Mexico immigration dimensions.", "conditions": {}, "estimatedWeeks": 10, "order": 3 },
        { "taskTitle": "Complete Formato Basico visa application", "phase": "Phase 3: Application", "description": "Download from the consulate website.", "conditions": {}, "estimatedWeeks": 8, "order": 4 },
        { "taskTitle": "Book consulate appointment", "phase": "Phase 3: Application", "description": "Mexican consulates often allow walk-ins, but booking is recommended.", "conditions": {}, "estimatedWeeks": 6, "order": 5 },
        { "taskTitle": "Attend consulate appointment", "phase": "Phase 3: Application", "description": "Bring originals and copies of everything. You'll receive a visa sticker in your passport.", "conditions": {}, "estimatedWeeks": 4, "order": 6 },
        { "taskTitle": "Gather marriage certificate for spouse visa", "phase": "Phase 2: Documentation", "conditions": { "family_situation": ["couple", "family"] }, "estimatedWeeks": 12, "order": 7 },
        { "taskTitle": "Gather birth certificates for dependents", "phase": "Phase 2: Documentation", "conditions": { "family_situation": "family" }, "estimatedWeeks": 12, "order": 8 },
        { "taskTitle": "Exchange visa for Temporary Resident Card at INM", "phase": "Phase 4: Arrival & Setup", "description": "Within 30 days of entry, visit INM to exchange your visa sticker for a physical resident card.", "links": [{ "label": "INM Appointments", "url": "https://citas.inm.gob.mx/" }], "conditions": {}, "estimatedWeeks": 0, "order": 9 },
        { "taskTitle": "Get CURP (population registry number)", "phase": "Phase 4: Arrival & Setup", "description": "Free, issued automatically with your INM card or at curp.gob.mx.", "links": [{ "label": "CURP", "url": "https://www.gob.mx/curp/" }], "conditions": {}, "estimatedWeeks": 0, "order": 10 },
        { "taskTitle": "Get RFC (tax ID) from SAT", "phase": "Phase 4: Arrival & Setup", "description": "Required for banking, employment, and tax filing in Mexico.", "links": [{ "label": "SAT", "url": "https://www.sat.gob.mx" }], "conditions": {}, "estimatedWeeks": 0, "order": 11 },
        { "taskTitle": "Open a Mexican bank account", "phase": "Phase 4: Arrival & Setup", "description": "BBVA or Santander are popular with expats. Bring your resident card, CURP, and proof of address.", "conditions": {}, "estimatedWeeks": 0, "order": 12 },
        { "taskTitle": "Research IMSS Voluntario (public health insurance)", "phase": "Phase 5: Residency Follow-up", "description": "Mexico's public health system offers affordable voluntary enrollment for residents (~$500/year).", "links": [{ "label": "IMSS Voluntario", "url": "http://www.imss.gob.mx/tramites/imss02025a" }], "conditions": {}, "estimatedWeeks": 0, "order": 13 }
      ]
    },

