{
  "wizardVersion": 1,
  "tracks": {
    "es_non_lucrative": {
      "displayName": "Spain - Non-Lucrative Visa",
      "countryId": "spain",
      "shortName": "NLV",
      "steps": [
        {
          "id": "personal",
          "title": "About You",
          "subtitle": "Tell us about your situation so we can personalize your checklist.",
          "questions": [
            {
              "id": "employment_status",
              "type": "single_choice",
              "label": "Current employment status",
              "options": [
                { "id": "retired", "label": "Retired" },
                { "id": "self_employed", "label": "Self-Employed" },
                { "id": "investor", "label": "Living off investments/savings" },
                { "id": "unemployed", "label": "Not currently working" }
              ],
              "required": true
            },
            {
              "id": "family_situation",
              "type": "single_choice",
              "label": "Who is relocating?",
              "options": [
                { "id": "single", "label": "Just me" },
                { "id": "couple", "label": "With partner/spouse" },
                { "id": "family", "label": "Family with children" }
              ],
              "required": true
            },
            {
              "id": "num_dependents",
              "type": "number",
              "label": "Number of children",
              "showIf": { "family_situation": "family" },
              "min": 1,
              "max": 10
            },
            {
              "id": "country_of_residence",
              "type": "single_choice",
              "label": "Current country of residence",
              "options": [
                { "id": "us", "label": "United States" },
                { "id": "uk", "label": "United Kingdom" },
                { "id": "canada", "label": "Canada" },
                { "id": "other_eu", "label": "Other EU country" },
                { "id": "other", "label": "Other" }
              ],
              "required": true
            }
          ]
        },
        {
          "id": "financial",
          "title": "Financial Readiness",
          "subtitle": "The NLV requires proof you can support yourself without working in Spain.",
          "questions": [
            {
              "id": "monthly_income_range",
              "type": "single_choice",
              "label": "Monthly passive income (USD)",
              "options": [
                { "id": "under_2000", "label": "Under $2,000" },
                { "id": "2000_3500", "label": "$2,000 - $3,500" },
                { "id": "3500_5000", "label": "$3,500 - $5,000" },
                { "id": "over_5000", "label": "Over $5,000" }
              ],
              "required": true,
              "hint": "Spain typically requires ~$2,800/month (IPREM x4) for the primary applicant."
            },
            {
              "id": "has_health_insurance",
              "type": "boolean",
              "label": "Do you already have international health insurance valid in Spain?",
              "required": true
            },
            {
              "id": "has_background_check",
              "type": "boolean",
              "label": "Do you already have a recent FBI/police background check?",
              "required": true
            },
            {
              "id": "has_apostille",
              "type": "boolean",
              "label": "Is your background check already apostilled?",
              "showIf": { "has_background_check": true },
              "required": false
            }
          ]
        },
        {
          "id": "timeline",
          "title": "Your Timeline",
          "subtitle": "We'll use this to calculate suggested due dates for each step.",
          "questions": [
            {
              "id": "target_move",
              "type": "single_choice",
              "label": "When do you plan to move?",
              "options": [
                { "id": "asap", "label": "As soon as possible" },
                { "id": "3_months", "label": "In ~3 months" },
                { "id": "6_months", "label": "In ~6 months" },
                { "id": "1_year", "label": "In ~1 year" }
              ],
              "required": true
            },
            {
              "id": "has_accommodation",
              "type": "boolean",
              "label": "Do you already have accommodation arranged in Spain?",
              "required": true
            },
            {
              "id": "has_consulate_appt",
              "type": "boolean",
              "label": "Have you booked a consulate appointment?",
              "required": true
            }
          ]
        }
      ],
      "taskRules": [
        {
          "taskTitle": "Research your assigned Spanish consulate",
          "phase": "Phase 1: Research & Planning",
          "description": "Find the Spanish consulate that covers your jurisdiction. Each US state is assigned to a specific consulate.",
          "links": [{ "label": "Consulate Finder", "url": "https://www.exteriores.gob.es/en/EmbajadasConsulados/Paginas/index.aspx" }],
          "conditions": {},
          "estimatedWeeks": 24,
          "order": 1
        },
        {
          "taskTitle": "Request FBI Identity History Summary",
          "phase": "Phase 2: Documentation",
          "description": "Order from FBI website. Takes 12-18 weeks by mail, or 3-5 days with an approved channeler.",
          "links": [{ "label": "FBI Identity History", "url": "https://www.fbi.gov/how-we-can-help-you/more-fbi-services-and-information/identity-history-summary-checks" }],
          "conditions": { "has_background_check": false, "country_of_residence": ["us"] },
          "estimatedWeeks": 20,
          "order": 2
        },
        {
          "taskTitle": "Get police background check from your country",
          "phase": "Phase 2: Documentation",
          "description": "Request an official criminal record check from your country's police or justice department.",
          "conditions": { "has_background_check": false, "country_of_residence": ["uk", "canada", "other_eu", "other"] },
          "estimatedWeeks": 18,
          "order": 2
        },
        {
          "taskTitle": "Apostille your background check",
          "phase": "Phase 2: Documentation",
          "description": "US: send to US State Department. UK: use the FCO. Canada: use Global Affairs Canada. Takes 4-8 weeks.",
          "links": [{ "label": "US Apostille Info", "url": "https://travel.state.gov/content/travel/en/records-and-authentications/authenticate-your-document/apostille-requirements.html" }],
          "conditions": { "has_apostille": false },
          "estimatedWeeks": 16,
          "order": 3
        },
        {
          "taskTitle": "Obtain international health insurance",
          "phase": "Phase 2: Documentation",
          "description": "Must be a full-coverage policy valid in Spain with no co-pays. Spanish consulates are strict about this.",
          "links": [
            { "label": "Sanitas (Spain)", "url": "https://www.sanitas.es" },
            { "label": "Cigna Global", "url": "https://www.cigna.com/global" }
          ],
          "conditions": { "has_health_insurance": false },
          "estimatedWeeks": 14,
          "order": 4
        },
        {
          "taskTitle": "Gather proof of passive income",
          "phase": "Phase 2: Documentation",
          "description": "Collect 12 months of bank statements, pension statements, or investment income proof. Must show income exceeds Spain's IPREM threshold.",
          "conditions": {},
          "estimatedWeeks": 14,
          "order": 5
        },
        {
          "taskTitle": "Gather additional income proof for spouse",
          "phase": "Phase 2: Documentation",
          "description": "Spain requires ~$700/month additional per dependent. Gather marriage certificate and combined financial docs.",
          "conditions": { "family_situation": ["couple", "family"] },
          "estimatedWeeks": 14,
          "order": 6
        },
        {
          "taskTitle": "Gather additional income proof for {num_dependents} child(ren)",
          "phase": "Phase 2: Documentation",
          "description": "Spain requires ~$350/month additional per child dependent. Gather birth certificates.",
          "conditions": { "family_situation": "family" },
          "estimatedWeeks": 14,
          "order": 7
        },
        {
          "taskTitle": "Get birth certificates apostilled",
          "phase": "Phase 2: Documentation",
          "description": "Birth certificates for all family members must be apostilled for the consulate application.",
          "conditions": { "family_situation": ["couple", "family"] },
          "estimatedWeeks": 14,
          "order": 8
        },
        {
          "taskTitle": "Get marriage certificate apostilled",
          "phase": "Phase 2: Documentation",
          "description": "Required if applying with a spouse.",
          "conditions": { "family_situation": ["couple", "family"] },
          "estimatedWeeks": 14,
          "order": 9
        },
        {
          "taskTitle": "Book consulate appointment",
          "phase": "Phase 3: Application",
          "description": "Book as early as possible — some consulates have 2-3 month wait times.",
          "conditions": { "has_consulate_appt": false },
          "estimatedWeeks": 12,
          "order": 10
        },
        {
          "taskTitle": "Complete visa application form (EX-01)",
          "phase": "Phase 3: Application",
          "description": "Download and fill out the national visa application form.",
          "links": [{ "label": "Visa Forms", "url": "https://www.exteriores.gob.es/Consulados/" }],
          "conditions": {},
          "estimatedWeeks": 8,
          "order": 11
        },
        {
          "taskTitle": "Prepare passport photos (recent, white background)",
          "phase": "Phase 3: Application",
          "description": "2 recent passport-sized photos with white background. Some consulates have specific size requirements.",
          "conditions": {},
          "estimatedWeeks": 8,
          "order": 12
        },
        {
          "taskTitle": "Attend consulate appointment",
          "phase": "Phase 3: Application",
          "description": "Bring all originals and copies. Expect to leave your passport. Processing takes 2-3 months.",
          "conditions": {},
          "estimatedWeeks": 6,
          "order": 13
        },
        {
          "taskTitle": "Secure accommodation in Spain",
          "phase": "Phase 3: Application",
          "description": "You'll need a rental contract or proof of accommodation for the visa application.",
          "links": [{ "label": "Idealista", "url": "https://www.idealista.com" }],
          "conditions": { "has_accommodation": false },
          "estimatedWeeks": 10,
          "order": 14
        },
        {
          "taskTitle": "Research schools for children in target city",
          "phase": "Phase 1: Research & Planning",
          "description": "Look into international schools, bilingual schools, or the Spanish public school system (colegios públicos).",
          "conditions": { "family_situation": "family" },
          "estimatedWeeks": 20,
          "order": 15
        },
        {
          "taskTitle": "Apply for NIE/TIE within 30 days of arrival",
          "phase": "Phase 4: Arrival & Setup",
          "description": "Once in Spain, apply for your Foreigner Identity Card (TIE) at the nearest Oficina de Extranjería.",
          "links": [{ "label": "Extranjería Info", "url": "https://www.inclusion.gob.es/web/migraciones/w/extranjeria" }],
          "conditions": {},
          "estimatedWeeks": 0,
          "order": 16
        },
        {
          "taskTitle": "Register at local town hall (Empadronamiento)",
          "phase": "Phase 4: Arrival & Setup",
          "description": "Register your address at the Ayuntamiento. This is required for most administrative procedures.",
          "conditions": {},
          "estimatedWeeks": 0,
          "order": 17
        },
        {
          "taskTitle": "Open a Spanish bank account",
          "phase": "Phase 4: Arrival & Setup",
          "description": "You'll need a NIE and proof of address. N26 or BBVA are popular with expats.",
          "links": [
            { "label": "BBVA", "url": "https://www.bbva.es" },
            { "label": "N26 Spain", "url": "https://n26.com/en-es" }
          ],
          "conditions": {},
          "estimatedWeeks": 0,
          "order": 18
        },
        {
          "taskTitle": "Register with Social Security (Seguridad Social)",
          "phase": "Phase 5: Residency Follow-up",
          "description": "If eligible for public healthcare, register at your local Social Security office.",
          "conditions": {},
          "estimatedWeeks": 0,
          "order": 19
        },
        {
          "taskTitle": "File annual tax declaration (Modelo 100)",
          "phase": "Phase 5: Residency Follow-up",
          "description": "As a tax resident, file Spanish income tax between April-June each year.",
          "conditions": {},
          "estimatedWeeks": 0,
          "order": 20
        }
      ]
    },

    "es_digital_nomad": {
      "displayName": "Spain - Digital Nomad Visa",
      "countryId": "spain",
      "shortName": "DNV",
      "steps": [
        {
          "id": "personal",
