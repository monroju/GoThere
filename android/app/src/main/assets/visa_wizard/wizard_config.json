            {
              "id": "employment_type",
              "type": "single_choice",
              "label": "Remote work arrangement",
              "options": [
                { "id": "employed", "label": "Employed by a foreign company" },
                { "id": "freelancer", "label": "Freelancer/Independent contractor" },
                { "id": "business_owner", "label": "Own a business registered outside Spain" }
              ],
              "required": true
            },
            {
              "id": "family_situation",
              "type": "single_choice",
              "label": "Who is relocating?",
              "options": [
                { "id": "single", "label": "Just me" },
                { "id": "couple", "label": "With partner/spouse" },
                { "id": "family", "label": "Family with children" }
              ],
              "required": true
            },
            {
              "id": "num_dependents",
              "type": "number",
              "label": "Number of children",
              "showIf": { "family_situation": "family" },
              "min": 1, "max": 10
            },
            {
              "id": "country_of_residence",
