{
  "name": "gothere-functions",
  "description": "GoThere Firebase Functions — Apple/Google IAP notifications + Anthropic AI proxy",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "deploy": "firebase deploy --only functions",
    "deploy:ai": "firebase deploy --only functions:aiProxy",
    "logs": "firebase functions:log",
    "logs:ai": "firebase functions:log --only aiProxy",
    "test": "node aiProxy.test.js && node iap.test.js"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^1.4.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.3.1"
  }
}
