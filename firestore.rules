rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IAP purchase → user lookup. Written by PurchaseManager on every
    // subscription purchase so the Firebase IAP function (Item 12) can map
    // ASC / Play notifications back to a Firebase user. Document key is the
    // transaction id (Apple) or purchaseToken (Google); body contains the uid.
    // Client may only create rows whose uid matches their own auth — admin
    // SDK (used by functions) bypasses this rule.
    match /iapPurchases/{key} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Referral code → owner map. Written and read ONLY by the referral Cloud
    // Functions via the Admin SDK (which bypasses these rules). Clients never
    // touch this collection directly — they read their own code from
    // users/{uid}.referralCode and redeem via the redeemReferral callable.
    match /referralCodes/{code} {
      allow read, write: if false;
    }

    // Fields on users/{uid} written ONLY by Cloud Functions (Admin SDK bypasses
    // rules). Clients read them but must never set them, or a user could grant
    // themselves referral months, forge referral state, or unlock paid content.
    // Entitlement fields: the apps read these back as grants, so a client write
    // would be a free unlock. On-device StoreKit / Play Billing stay the source of
    // truth; the apps' own mirror writes of these fields now fail silently.
    function serverOnlyUserFields() {
      return ['promoAccessUntil', 'referralCode', 'referredBy', 'referredByUid',
              'referredAt', 'referralGrantsCount',
              'unlockedCountries', 'ownedSKUs', 'subscriptionStatus',
              'hasAllAccess', 'legacyPaidInstall'];
    }

    // Concierge waitlist, one doc per user, keyed by uid.
    match /conciergeWaitlist/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
    }

    // Per-user document
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(serverOnlyUserFields());
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(serverOnlyUserFields());

      // Tasks
      match /tasks/{taskId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 500;
        allow update: if request.auth != null && request.auth.uid == uid;
      }

      // Events (Calendar)
      match /events/{eventId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0;
      }

      // Documents
      match /documents/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Forms
      match /forms/{formId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Decision profiles
      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Recommendations (Android writes ranked rows into an items subcollection)
      match /recommendations/{recId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /items/{itemId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // iOS destinations; each holds its own task list
      match /destinations/{destId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /tasks/{taskId} {
          allow read, delete: if request.auth != null && request.auth.uid == uid;
          allow create: if request.auth != null && request.auth.uid == uid
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 500;
          allow update: if request.auth != null && request.auth.uid == uid;
        }
      }

      // iOS wizard document slots
      match /documentSlots/{slotId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Android calendar notes
      match /calendar/{dateId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Android user resources
      match /resources/{resourceId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Wizard results
      match /wizardResults/{resultId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
