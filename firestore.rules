rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IAP purchase → user lookup. Written by PurchaseManager on every
    // subscription purchase so the Firebase IAP function (Item 12) can map
    // ASC / Play notifications back to a Firebase user. Document key is the
    // transaction id (Apple) or purchaseToken (Google); body contains the uid.
    // Client may only create rows whose uid matches their own auth — admin
    // SDK (used by functions) bypasses this rule.
    match /iapPurchases/{key} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Per-user document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Tasks
      match /tasks/{taskId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 500;
        allow update: if request.auth != null && request.auth.uid == uid;
      }

      // Events (Calendar)
      match /events/{eventId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0;
      }

      // Documents
      match /documents/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Forms
      match /forms/{formId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Decision profiles
      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Recommendations
      match /recommendations/{recId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Wizard results
      match /wizardResults/{resultId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
